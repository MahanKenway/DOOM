diff --git a/cmake/FindSDL2_mixer.cmake b/cmake/FindSDL2_mixer.cmake
new file mode 100644
index 0000000..f249f33
--- /dev/null
+++ b/cmake/FindSDL2_mixer.cmake
@@ -0,0 +1,18 @@
+# Browser-only adapter for C-Dogs SDL.
+# Emscripten provides SDL2_mixer through its maintained port, but that port
+# does not expose a CMake package config. This target maps the upstream
+# project expectation to the official -sUSE_SDL_MIXER=2 flag.
+if(NOT EMSCRIPTEN)
+  message(FATAL_ERROR "This SDL2_mixer finder is only intended for the Emscripten prototype build.")
+endif()
+
+if(NOT TARGET SDL2_mixer::SDL2_mixer)
+  add_library(SDL2_mixer::SDL2_mixer INTERFACE IMPORTED)
+  set_target_properties(SDL2_mixer::SDL2_mixer PROPERTIES
+    INTERFACE_INCLUDE_DIRECTORIES "${EMSCRIPTEN_SYSROOT}/include/SDL2"
+    INTERFACE_LINK_OPTIONS "SHELL:-sUSE_SDL_MIXER=2"
+  )
+endif()
+
+set(SDL2_mixer_FOUND TRUE)
+set(SDL2_mixer_VERSION "2")
