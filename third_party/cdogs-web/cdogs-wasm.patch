diff --git a/src/cdogs/utils.c b/src/cdogs/utils.c
index 5e31c93..ded0d5c 100644
--- a/src/cdogs/utils.c
+++ b/src/cdogs/utils.c
@@ -694,5 +694,42 @@ end:
 
 SDL_Surface *LoadImgToSurface(const char *path)
 {
+#ifdef __EMSCRIPTEN__
+	// Decode from a memory buffer in browser builds. This avoids seek-based
+	// SDL_RW callbacks that can stall on the virtual filesystem during startup.
+	FILE *f = fopen(path, "rb");
+	if (f == NULL)
+	{
+		SDL_SetError("Cannot open image '%s': %s", path, strerror(errno));
+		return NULL;
+	}
+	if (fseek(f, 0, SEEK_END) != 0)
+	{
+		fclose(f);
+		SDL_SetError("Cannot seek image '%s'", path);
+		return NULL;
+	}
+	const long size = ftell(f);
+	if (size <= 0 || fseek(f, 0, SEEK_SET) != 0)
+	{
+		fclose(f);
+		SDL_SetError("Cannot size image '%s'", path);
+		return NULL;
+	}
+	unsigned char *buffer;
+	CMALLOC(buffer, (size_t)size);
+	const size_t read = fread(buffer, 1, (size_t)size, f);
+	fclose(f);
+	if (read != (size_t)size)
+	{
+		CFREE(buffer);
+		SDL_SetError("Cannot read image '%s'", path);
+		return NULL;
+	}
+	SDL_Surface *image = STBIMG_LoadFromMemory(buffer, (int)size);
+	CFREE(buffer);
+	return image;
+#else
 	return STBIMG_Load(path);
+#endif
 }
